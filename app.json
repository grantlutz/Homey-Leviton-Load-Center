  "homeyCommunityTopicId": 157620,
  "flow": {
    "actions": [
      {
        "id": "all_off",
        "title": {
          "en": "Turn all breakers off"
        },
        "titleFormatted": {
          "en": "Turn all breakers off on [[panel]]"
        },
        "hint": {
          "en": "Staggered remote-off/trip of every controllable breaker on the selected load center."
        },
        "args": [
          {
            "name": "panel",
            "type": "device",
            "filter": "driver_id=panel"
          }
        ]
      },
      {
        "id": "all_on",
        "title": {
          "en": "Turn all breakers on"
        },
        "titleFormatted": {
          "en": "Turn all breakers on on [[panel]]"
        },
        "hint": {
          "en": "Staggered remote-on of every Gen-2 controllable breaker on the selected load center."
        },
        "args": [
          {
            "name": "panel",
            "type": "device",
            "filter": "driver_id=panel"
          }
        ]
      },
      {
        "id": "trip_all",
        "title": {
          "en": "Trip all breakers"
        },
        "titleFormatted": {
          "en": "Trip all breakers on [[panel]]"
        },
        "hint": {
          "en": "Staggered remote-trip of every smart breaker on the selected load center. Gen-1 breakers cannot be re-closed remotely."
        },
        "args": [
          {
            "name": "panel",
            "type": "device",
            "filter": "driver_id=panel"
          }
        ]
      },
      {
        "id": "turn_on",
        "title": {
          "en": "Turn breaker on"
        },
        "hint": {
          "en": "Remotely closes a Gen-2 breaker. No effect on Gen-1 (trip-only) breakers."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=breaker"
          }
        ]
      },
      {
        "id": "turn_off",
        "title": {
          "en": "Turn breaker off"
        },
        "hint": {
          "en": "Remotely trips the breaker off."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=breaker"
          }
        ]
      },
      {
        "id": "trip",
        "title": {
          "en": "Trip breaker"
        },
        "hint": {
          "en": "One-way remote trip. Gen-1 breakers cannot be re-closed remotely."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=breaker"
          }
        ]
      },
      {
        "id": "identify",
        "title": {
          "en": "Blink locate LED"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=breaker"
          }
        ]
      },
      {
        "id": "identify_panel",
        "title": {
          "en": "Blink hub locate LED"
        },
        "hint": {
          "en": "Blinks the LWHEM hub's LED for ~10 seconds. Not supported on LDATA panels."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=panel"
          }
        ]
      }
    ],
    "triggers": [
      {
        "id": "breaker_tripped",
        "title": {
          "en": "A breaker tripped"
        },
        "titleFormatted": {
          "en": "This breaker tripped ([[reason]])"
        },
        "hint": {
          "en": "Fires when this breaker enters a tripped/fault state. Pick a specific reason to filter, or 'Any reason'."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=breaker"
          },
          {
            "name": "reason",
            "type": "dropdown",
            "title": {
              "en": "Reason"
            },
            "values": [
              {
                "id": "any",
                "label": {
                  "en": "Any reason"
                }
              },
              {
                "id": "software_trip",
                "label": {
                  "en": "Remote trip"
                }
              },
              {
                "id": "gfci_fault",
                "label": {
                  "en": "Ground fault (GFCI)"
                }
              },
              {
                "id": "afci_fault",
                "label": {
                  "en": "Arc fault (AFCI)"
                }
              },
              {
                "id": "afci_miswire",
                "label": {
                  "en": "AFCI miswire"
                }
              },
              {
                "id": "overcurrent_trip",
                "label": {
                  "en": "Overcurrent"
                }
              },
              {
                "id": "overload_trip",
                "label": {
                  "en": "Overload"
                }
              },
              {
                "id": "short_circuit_trip",
                "label": {
                  "en": "Short circuit"
                }
              },
              {
                "id": "upstream_fault",
                "label": {
                  "en": "Upstream fault"
                }
              }
            ]
          }
        ],
        "tokens": [
          {
            "name": "reason",
            "type": "string",
            "title": {
              "en": "Trip reason"
            },
            "example": {
              "en": "GFCI fault"
            }
          },
          {
            "name": "power",
            "type": "number",
            "title": {
              "en": "Power (W)"
            },
            "example": 0
          }
        ]
      },
      {
        "id": "power_rose_above",
